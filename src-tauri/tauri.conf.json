{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kafka Suite",
  "version": "2.0.0",
  "identifier": "org.akbal.kafkasuite",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run sidecar && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "kafka-suite",
        "width": 1600,
        "height": 980,
        "minWidth": 1100,
        "minHeight": 640,
        "backgroundColor": "#101215"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "akbal",
    "shortDescription": "Desktop Kafka cluster viewer",
    "longDescription": "Browse topics, read and live-tail messages, and produce test messages on Apache Kafka clusters.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "resources": {
      "resources/kafka-sidecar.jar": "kafka-sidecar.jar",
      "resources/runtime/": "runtime/"
    }
  }
}
